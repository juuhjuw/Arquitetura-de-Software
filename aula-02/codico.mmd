   classDiagram
class Pedido {
    - id: String
    - clienteId: String
    - restauranteId: String
    - itens: Lista~Item~
    - total: Double
    - status: StatusPedido
    - criadoEm: DataHora
    - entregueEm: DataHora
    + criarPedido(clienteId, restauranteId, itens)
    + atualizarStatus(status)
    + calcularTotal()
    + cancelarPedido()
}
class Item {
    - id: String
    - nome: String
    - quantidade: Int
    - preco: Double
    + calcularSubtotal()
}
class StatusPedido {
    <<enumeration>>
    PENDENTE
    CONFIRMADO
    EM_PREPARACAO
    EM_ENTREGA
    ENTREGUE
    CANCELADO
}
class Pagamento {
    - id: String
    - pedidoId: String
    - valor: Double
    - metodo: MetodoPagamento
    - status: StatusPagamento
    + processarPagamento()
    + estornarPagamento()
}
class StatusPagamento {
    <<enumeration>>
    PENDENTE
    APROVADO
    RECUSADO
    ESTORNADO
}
class ServicoNotificacao {
    <<interface>>
    + enviarNotificacao(mensagem, destinatario)
}
class NotificacaoEmail {
    + enviarNotificacao(mensagem, destinatario)
}
class NotificacaoSMS {
    + enviarNotificacao(mensagem, destinatario)
}
Pedido --> StatusPedido : possui
Pedido --> Item : contém
Pedido --> Pagamento : gera
Pagamento --> StatusPagamento : possui
Pedido --> ServicoNotificacao : usa
NotificacaoEmail ..|> ServicoNotificacao : implementa
NotificacaoSMS ..|> ServicoNotificacao : implementa